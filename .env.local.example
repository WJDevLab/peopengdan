# ── YouTube Data API v3 ────────────────────────────────────────────
# https://console.cloud.google.com → API 및 서비스 → 사용자 인증 정보
# 무료. 결제 수단 등록 불필요. 일 10,000 유닛.
YOUTUBE_API_KEY=

# ── Supabase ───────────────────────────────────────────────────────
# https://supabase.com/dashboard → 프로젝트 → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role 키는 절대 클라이언트에 노출하지 말 것. 수집 스크립트 전용.
SUPABASE_SERVICE_ROLE_KEY=
